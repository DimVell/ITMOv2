{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "build",
  "provider": {
    "vsellm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "VseLLM",
      "options": {
        "baseURL": "https://litellm.data-light.ru",
        "apiKey": "{env:VSELLM_API_KEY}"
      },
      "models": {
        "openai/gpt-5": {
          "name": "openai/gpt-5"
        },
        "anthropic/claude-sonnet-4": {
          "name": "anthropic/claude-sonnet-4"
        }
      }
    }
  },
  "skills": {
    "paths": [
      ".opencode/skills"
    ]
  },
  "mcp": {
    "git": {
      "type": "local",
      "command": [
        "/Users/dimvell/ITMOv2/.opencode/mcp/git-venv/bin/python3",
        "-m",
        "mcp_server_git",
        "--repository",
        "/Users/dimvell/ITMOv2"
      ],
      "enabled": true,
      "environment": {}
    },
    "filesystem-demo": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "/Users/dimvell/ITMOv2/practices/practice_03/lab/demo"
      ],
      "enabled": true,
      "environment": {}
    },
    "mini-echo": {
      "type": "local",
      "command": [
        "node",
        "/Users/dimvell/ITMOv2/.opencode/mcp/mini-echo.js"
      ],
      "enabled": true,
      "environment": {}
    }
  }
}
