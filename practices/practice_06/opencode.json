{
  "$schema": "https://opencode.ai/config.json",
  "model": "ollama/itmo-agent",
  "small_model": "ollama/itmo-agent",
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama local",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "itmo-agent": {
          "name": "ITMO local 64k",
          "limit": {
            "context": 65536,
            "output": 4096
          }
        }
      }
    }
  },
  "agent": {
    "threat-judge": {
      "description": "Independent reviewer of the submitted threat model",
      "mode": "primary",
      "prompt": "{file:./judge-system-prompt.md}",
      "steps": 8,
      "permission": {
        "*": "deny",
        "read": {
          "*": "deny"
        }
      }
    },
    "shop-planner": {
      "description": "Model under test: produces a shop action without executing tools",
      "mode": "primary",
      "prompt": "{file:./planner-system.txt}",
      "permission": { "*": "deny" }
    }
  }
}
